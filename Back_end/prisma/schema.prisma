// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

 type PaginaHistoria {
  numero     Int
  texto      String
  imagem_url String?
}

model Responsavel {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  nome     String
  email    String    @unique
  senha    String
  criancas Crianca[]
}


model Crianca {
  id                    String      @id @default(auto()) @map("_id") @db.ObjectId
  responsavel_id        String      @db.ObjectId
  responsavel           Responsavel @relation(fields: [responsavel_id], references: [id])
  nome                  String
  idade                 Int
  numero_pagina         Int         @default(5)
  temas_favoritos       String[]
  temas_evitar          String[]
  personagens_favoritos String[]
  historias             Historia[]
}


model Historia {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  crianca_id          String           @db.ObjectId
  crianca             Crianca          @relation(fields: [crianca_id], references: [id])
  prompt_pai          String
  temas_identificados String[]
  paginas             PaginaHistoria[] 
  criado_em           DateTime         @default(now())
}